# Copy to .env before running `docker compose up`.
# All values below are training-only placeholders — never real credentials.

# --- PostgreSQL ---
POSTGRES_DB=saksbehandling
POSTGRES_USER=saksbehandling
POSTGRES_PASSWORD=TRAINING-ONLY-DB-PASSWORD-0001
POSTGRES_PORT=5432

# --- API ---
API_PORT=5080

# --- Frontend ---
FRONTEND_PORT=5173
# Reached from the browser, so this must be a host-mapped URL, not the
# Docker-internal service name.
VITE_API_BASE_URL=http://localhost:5080
